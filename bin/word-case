#!/bin/sh
#
# word-case: change the text to one word, and the separator is a low line.
#
# Example:
#
#     $ echo "Foo Goo Hoo" | word-case
#     Foo_Goo_Hoo
#
#     $ echo "Can't Stop Won't Stop" | word-case
#     Cant_Stop_Wont_Stop
#
# The script does this:
#
#   * Delete any quotation mark.
#
#   * Translate any non-alphanumeric to a separator i.e. low line.
#
#   * Flatten any separator run.
# 
#   * Trim any leading/trailing separator.
#
# Note that word-case and slug-case are identical except:
#
#   * word-case uses a low line; slug-case uses a hyphen-minus.
#
#   * word-case preserves capitalization; slug-case coverts to lower-case.
#
perl -pe "use open ':std', ':encoding(UTF-8)'; s/\p{Quotation_Mark}//g; s/[^[:alnum:]]/_/g; s/__+/_/g; s/^_//; s/_$//"

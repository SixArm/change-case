#!/bin/sh
#
# snake-case: change each word to use snake-case format.
#
# Examples:
#
#     $ echo "FooGooHoo" | snake-case
#     foo_goo_hoo
#
#     $ echo "AlphaBravo CharlieDelta EchoFoxtrot" | snake-case
#     alpha_bravo charlie_delta echo_foxtrot
#
# The script does this:
#
#   * Find each transition i.e. a lower-case alphanumeric character followed by
#     an upper-case alphabetic character.
#
#   * Split the transition by inserting a separator i.e. low line.
#
#   * Translate any punctuation run to a separator.
#
#   * Change case to lower case.
#
# Note that snake-case and kebab-case are intentionally identical, except for
# the separator:
#
#   * snake-case uses a low line.
#
#   * kebab-case uses a hypen-minus.
#
perl -pe "use open ':std', ':encoding(UTF-8)'; s/([[:lower:][:digit:]])([[:upper:]])/\1_\2/g; s/\p{Punct}+/_/g; \$_=lc(\$_)"

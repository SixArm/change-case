#!/bin/sh
#
# camel-case: change each word to use camel-case format.
#
# Examples:
#
#     $ echo "foo-goo-hoo" | camel-case
#     fooGooHoo
#
#     $ echo "Alpha@bravo Charlie&delta Echo*foxtrot" | camel-case
#     alphaBravo charlieDelta echoFoxtrot
#
# The script does this:
#
#   * Find each separator i.e. any punctuation character run.
#
#   * Delete the separator.
#
#   * Convert the character after the separator to upper-case.
#
#   * Convert each word's first alphanumeric character to upper-case.
#
# Note that camel-case and pascal-case are identical, except for each word's
# first alphanumeric character:
#
#   * camel-case converts it to lower-case.
#
#   * pascal-case converts it to upper-case.
#
perl -pe "use open ':std', ':encoding(UTF-8)'; s/\p{Punct}+([[:alnum:]])/\U\1/g; s/\b([[:alnum:]])/\L\1/g"
